{
  // Cloudflare Pages 설정.
  // 예전에는 Workers 형식("assets")이라 Pages 가 바인딩을 읽지 못했다.
  // Pages 는 pages_build_output_dir 가 있어야 이 파일을 자기 설정으로 인식한다.
  "name": "roastpoint",
  "compatibility_date": "2026-08-09",
  "pages_build_output_dir": ".",

  // 기기 간 동기화·잇기가 쓰는 저장소.
  // functions/api/sync.js 와 functions/api/pair.js 가 env.ROASTPOINT_KV 로 접근한다.
  "kv_namespaces": [
    { "binding": "ROASTPOINT_KV", "id": "136d6a46b03244299e8b7e514efd9d15" }
  ]
}
